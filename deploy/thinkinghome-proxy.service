[Unit]
Description=ThinkingHome Alice proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thinkinghome
WorkingDirectory=/opt/thinkinghome-proxy
ExecStart=/opt/thinkinghome-proxy/ThinkingHome.DeviceModel.Proxy
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=DOTNET_ENVIRONMENT=Production
# Секрет подписи JWT — из отдельного файла, НЕ в репозитории (см. runbook):
EnvironmentFile=/etc/thinkinghome/proxy.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
