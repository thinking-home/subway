<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
        <Description>Серверная сторона прокси ThinkingHome: SignalR-хаб, реестр домашних хостов, токены; IDeviceHost-прокси для каждого дома</Description>
        <PackageTags>smart-home;iot;signalr;proxy;hub</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ThinkingHome.DeviceModel.Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThinkingHome.DeviceModel\ThinkingHome.DeviceModel.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    </ItemGroup>

</Project>
