<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>thinkinghome-devicemodel-hub</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- как в Worker SDK: неймспейсы Generic Host доступны без using в каждом файле -->
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThinkingHome.DeviceModel\ThinkingHome.DeviceModel.csproj" />
        <ProjectReference Include="..\ThinkingHome.DeviceModel.Remoting.ProxyClient\ThinkingHome.DeviceModel.Remoting.ProxyClient.csproj" />
        <ProjectReference Include="..\ThinkingHome.DeviceModel.Drivers.Stubs\ThinkingHome.DeviceModel.Drivers.Stubs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    </ItemGroup>

</Project>
