<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
        <Description>Wire-контракт удалённого доступа к хосту устройств ThinkingHome (методы SignalR-хаба)</Description>
        <PackageTags>smart-home;iot;signalr;remoting</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThinkingHome.DeviceModel\ThinkingHome.DeviceModel.csproj" />
    </ItemGroup>

</Project>
