<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
        <Description>Коннектор домашнего хоста ThinkingHome: подключает локальный IDeviceHost к облачному прокси по SignalR, включая привязку по OTP</Description>
        <PackageTags>smart-home;iot;signalr;proxy;connector</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThinkingHome.DeviceModel\ThinkingHome.DeviceModel.csproj" />
        <ProjectReference Include="..\ThinkingHome.DeviceModel.Remoting\ThinkingHome.DeviceModel.Remoting.csproj" />
    </ItemGroup>

</Project>
