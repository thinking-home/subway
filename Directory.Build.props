<Project>

    <!-- Общие свойства всех проектов решения. Публикация в NuGet — явный опт-ин:
         IsPackable=true + Description ставятся только в публикуемых csproj. -->
    <PropertyGroup>
        <Authors>Dmitry Andriyanov</Authors>
        <Copyright>© 2026 Dmitry Andriyanov</Copyright>
        <Version>0.1.0</Version>
        <RepositoryUrl>https://github.com/thinking-home/subway</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
